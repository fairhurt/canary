{
	"name": "sveltekit-canary",
	"version": "0.1.1",
	"description": "Modern feature flagging library for SvelteKit with A/B testing, user groups, and remote functions",
	"license": "MIT",
	"author": "Tyson Fairhurst",
	"homepage": "https://canary-seven.vercel.app/",
	"repository": {
		"type": "git",
		"url": "https://github.com/fairhurt/canary.git"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"feature-flags",
		"feature-toggles",
		"ab-testing",
		"remote-functions",
		"rollout",
		"canary-deployment"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run check && npm run test && npm run lint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prettier:fix": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "playwright test",
		"publish:check": "npm run check && npm run test && npm run lint && npm publish --dry-run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"valibot": "^1.5.0"
	}
}
